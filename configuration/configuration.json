{
  "db_name": "masterDb",
  "db_path": "masterDb/masterDb.db",
  "version_db_name": "versionDb",
  "version_db_path": "versionDb/versionDb.db",
  "tables": [
    {
      "id": 1,
      "name": "sys_databases",
      "columns": [
        { "name": "database_id", "type": "Int", "hasIdentity": true},
        { "name": "name", "type": "String", "size": 100 },
        { "name": "filepath", "type": "String", "size": 100 },
        { "name": "is_system", "type": "Bool" },
        { "name": "created_at", "type": "DateTime" },
        { "name": "last_modified", "type": "DateTime" },
        { "name": "last_modified_by", "type": "String", "size": 100 },
        { "name": "version", "type": "Int", "default": 1 },
        { "name": "is_deleted", "type": "Bool", "default": 0 },
        { "name": "deleted_at", "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["database_id"]
    },
    {
      "id": 2,
      "name": "sys_schemas",
      "columns": [
        { "name": "database_id", "type": "Int" },
        { "name": "schema_id", "type": "Int", "hasIdentity": true},
        { "name": "name", "type": "String", "size": 100 },
        { "name": "created_at", "type": "DateTime" },
        { "name": "last_modified", "type": "DateTime" },
        { "name": "last_modified_by", "type": "String", "size": 100 },
        { "name": "version", "type": "Int", "default": 1 },
        { "name": "is_deleted", "type": "Bool", "default": 0 },
        { "name": "deleted_at", "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["database_id", "schema_id"]
    },
    {
      "id": 3,
      "name": "sys_tables",
      "columns": [
        { "name": "database_id", "type": "Int" },
        { "name": "table_id", "type": "Int", "hasIdentity": true},
        { "name": "schema_id", "type": "Int" },
        { "name": "name", "type": "String", "size": 100 },
        { "name": "ordinal_position", "type": "Int" },
        { "name": "is_system", "type": "Bool" },
        { "name": "created_at", "type": "DateTime" },
        { "name": "last_modified", "type": "DateTime" },
        { "name": "last_modified_by", "type": "String", "size": 100 },
        { "name": "version", "type": "Int", "default": 1 },
        { "name": "is_deleted", "type": "Bool", "default": 0 },
        { "name": "deleted_at", "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["database_id","table_id"]
    },
    {
      "id": 4,
      "name": "sys_columns",
      "columns": [
        { "name": "table_id", "type": "Int" },
        { "name": "column_id", "type": "Int", "hasIdentity": true},
        { "name": "name", "type": "String", "size": 100 },
        { "name": "data_type", "type": "TinyInt" },
        { "name": "record_size", "type": "Int" },
        { "name": "precision", "type": "SmallInt", "nullable": true },
        { "name": "scale", "type": "SmallInt", "nullable": true },
        { "name": "is_nullable", "type": "Bool" },
        { "name": "ordinal_position", "type": "SmallInt" },
        { "name": "is_system", "type": "Bool" },
        { "name": "created_at", "type": "DateTime" },
        { "name": "last_modified", "type": "DateTime" },
        { "name": "last_modified_by", "type": "String", "size": 100 },
        { "name": "version", "type": "Int", "default": 1 },
        { "name": "is_deleted", "type": "Bool", "default": 0 },
        { "name": "deleted_at", "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["table_id", "column_id"]
    },
    {
      "id": 5,
      "name": "sys_indexes",
      "columns": [
        { "name": "table_id", "type": "Int" },
        { "name": "index_id", "type": "Int", "hasIdentity": true},
        { "name": "name", "type": "String", "size": 100 },
        { "name": "is_clustered", "type": "Bool" },
        { "name": "is_disabled", "type": "Bool" },
        { "name": "created_at", "type": "DateTime" },
        { "name": "last_modified", "type": "DateTime" },
        { "name": "last_modified_by", "type": "String", "size": 100 },
        { "name": "version", "type": "Int", "default": 1 },
        { "name": "is_deleted", "type": "Bool", "default": 0 },
        { "name": "deleted_at", "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["table_id", "index_id"]
    },
    {
      "id": 6,
      "name": "sys_identity_columns",
      "columns": [
        { "name": "table_id",     "type": "Int" },
        { "name": "column_id",    "type": "Int" },
        { "name": "seed_value",   "type": "Int" },
        { "name": "increment",    "type": "Int" },
        { "name": "last_value",   "type": "BigInt" },
        { "name": "is_cached",    "type": "Bool" },
        { "name": "cache_block",  "type": "Int" },
        { "name": "version",      "type": "Int", "default": 1 },
        { "name": "is_deleted",   "type": "Bool", "default": 0 },
        { "name": "deleted_at",   "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["table_id", "column_id"]
    },
    {
      "id": 7,
      "name": "sys_index_columns",
      "columns": [
        { "name": "index_id",         "type": "Int" },
        { "name": "column_id",        "type": "Int" },
        { "name": "ordinal_position", "type": "SmallInt" },
        { "name": "is_included",      "type": "Bool" },
        { "name": "version",          "type": "Int", "default": 1 },
        { "name": "is_deleted",       "type": "Bool", "default": 0 },
        { "name": "deleted_at",       "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["index_id", "column_id"]
    },
    {
      "id": 8,
      "name": "sys_constraints",
      "columns": [
        { "name": "table_id",             "type": "Int" },
        { "name": "constraint_id",        "type": "Int", "hasIdentity": true},
        { "name": "name",                 "type": "String", "size": 100 },
        { "name": "constraint_type",      "type": "TinyInt" },
        { "name": "is_disabled",          "type": "Bool" },
        { "name": "constraint_index_id",  "type": "Int", "nullable": true },
        { "name": "created_at",           "type": "DateTime" },
        { "name": "last_modified",        "type": "DateTime" },
        { "name": "last_modified_by",     "type": "String", "size": 100 },
        { "name": "version",              "type": "Int", "default": 1 },
        { "name": "is_deleted",           "type": "Bool", "default": 0 },
        { "name": "deleted_at",           "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["table_id", "constraint_id"]
    },
    {
      "id": 9,
      "name": "sys_constraint_columns",
      "columns": [
        { "name": "constraint_id",    "type": "Int" },
        { "name": "column_id",        "type": "Int" },
        { "name": "ordinal_position", "type": "Int" },
        { "name": "version",          "type": "Int", "default": 1 },
        { "name": "is_deleted",       "type": "Bool", "default": 0 },
        { "name": "deleted_at",       "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["constraint_id", "column_id"]
    },
    {
      "id": 10,
      "name": "sys_default_values",
      "columns": [
        { "name": "column_id",  "type": "Int" },
        { "name": "value",      "type": "String", "size": 255 },
        { "name": "version",    "type": "Int", "default": 1 },
        { "name": "is_deleted", "type": "Bool", "default": 0 },
        { "name": "deleted_at", "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["column_id"]
    },
    {
      "id": 11,
      "name": "sys_table_stats",
      "columns": [
        { "name": "table_id",             "type": "Int" },
        { "name": "row_count",            "type": "BigInt", "default": 0 },
        { "name": "avg_record_size",      "type": "Int",    "default": 0 },
        { "name": "page_count",           "type": "Int",    "default": 0 },
        { "name": "last_modified_at",     "type": "DateTime"}
      ],
      "primaryKey": ["table_id"]
    },
    {
      "id": 12,
      "name": "sys_column_stats",
      "columns": [
        { "name": "column_id",            "type": "Int" },
        { "name": "distinct_count",       "type": "BigInt", "default": 0 },
        { "name": "min_value",            "type": "String", "size": 200, "nullable": true },
        { "name": "max_value",            "type": "String", "size": 200, "nullable": true },
        { "name": "null_count",           "type": "BigInt", "nullable": true }
      ],
      "primaryKey": ["column_id"]
    },
    {
      "id": 13,
      "name": "sys_column_histograms",
      "columns": [
        { "name": "column_id",            "type": "Int" },
        { "name": "histogram_id",         "type": "Int",    "hasIdentity": true },
        { "name": "range_start",          "type": "String", "size": 200, "nullable": true },
        { "name": "range_end",            "type": "String", "size": 200, "nullable": true },
        { "name": "row_count",            "type": "Int",    "default":  0},
        { "name": "distinct_count",       "type": "Int",    "default": 0 }
      ],
      "primaryKey": ["column_id", "histogram_id"]
    },
    {
      "id": 14,
      "name": "sys_roles",
      "columns": [
        { "name": "role_id",                  "type": "Int", "hasIdentity": true},
        { "name": "role_name",                "type": "String", "size": 100 },
        { "name": "permissions",              "type": "Int" },
        { "name": "is_system_role",           "type": "Bool" },
        { "name": "created_at",               "type": "DateTime" },
        { "name": "last_modified",            "type": "DateTime" },
        { "name": "last_modified_by",         "type": "String", "size": 100 },
        { "name": "version",                  "type": "Int",    "default": 1 },
        { "name": "is_deleted",               "type": "Bool",   "default": 0 },
        { "name": "deleted_at",               "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["role_id"]
    },
    {
      "id": 15,
      "name": "sys_users",
      "columns": [
        { "name": "user_id",                      "type": "Int", "hasIdentity": true},
        { "name": "username",                     "type": "String", "size": 100 },
        { "name": "password_hash",                "type": "String", "size": 200 },
        { "name": "role_id",                      "type": "Int" },
        { "name": "is_active",                    "type": "Bool" },
        { "name": "created_at",                   "type": "DateTime" },
        { "name": "last_modified",                "type": "DateTime" },
        { "name": "last_modified_by",             "type": "String", "size": 100 },
        { "name": "version",                      "type": "Int",    "default": 1 },
        { "name": "is_deleted",                   "type": "Bool",   "default": 0 },
        { "name": "deleted_at",                   "type": "DateTime", "nullable": true }
      ],
      "primaryKey": ["user_id"]
    },
    {
      "id": 16,
      "name": "sys_index_stats",
      "columns": [
        { "name": "table_id",                     "type": "Int" },
        { "name": "index_id",                     "type": "Int" },
        { "name": "leaf_pages",                   "type": "Int",      "default": 0 },
        { "name": "depth",                        "type": "TinyInt",  "default": 0 },
        { "name": "avg_fragmentation",            "type": "Decimal",  "size": 4 },
        { "name": "last_modified_at",             "type": "DateTime" }
      ],
      "primaryKey": ["table_id", "index_id"]
    }

  ]
}
